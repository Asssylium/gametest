# Copy to .env and edit:  cp .env.example .env
# Real environment variables override values in .env.

# Port the API listens on (client/.env API_URL must point here)
PORT=3001

# MongoDB Atlas connection; keep credentials private.
MONGODB_URI=
MONGODB_DATABASE=mentor_game

# Authentication: set a long, random secret before using protected routes.
JWT_SECRET=

# Protects the scheduled email endpoint on Vercel.
CRON_SECRET=

# SMTP credentials for registration and scheduled email.
SMTP_USER=
SMTP_PASS=
EMAIL_USER=

# PayOS credentials for real payment links and webhooks.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
