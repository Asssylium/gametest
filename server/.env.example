# Copy to .env and edit:  cp .env.example .env
# Real environment variables override values in .env.

# Port the API listens on (client/.env API_URL must point here)
PORT=3001

# MySQL connection – same keys as GamesPlatform_Backend/.env
# Use 127.0.0.1 here (Node runs on the host, not inside Docker)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mentor_game
DB_USERNAME=huonght
DB_PASSWORD=

# Separate database used by `npm test` (reset before every test – never point it at real data)
DB_TEST_DATABASE=mentor_game_test
